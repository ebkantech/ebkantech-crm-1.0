PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ebkantech-crm

# Where the frontend dev server runs — CORS only allows this origin.
CLIENT_ORIGIN=http://localhost:5173
# Where the frontend is reachable from the outside — used to build links in emails.
APP_URL=http://localhost:5173

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# SMTP — used to send "welcome" and "reset password" emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Day Book <no-reply@example.com>"
